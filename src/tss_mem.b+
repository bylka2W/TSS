state TSS_Mem { ctl, tmp, free_ptr, page }

export entry TSS_Mem {
    ctl = VirtualAlloc(0, 16, 0x1000, 0x04)
    tmp = VirtualAlloc(0, 1048576, 0x1000, 0x04)
    *ctl = tmp
    TlsSetValue(0, ctl)
    page = ctl
}

export entry TSS_AllocPage {
    ctl = TlsGetValue(0)
    free_ptr = *ctl
    *ctl = free_ptr + 4096
    page = free_ptr
}
