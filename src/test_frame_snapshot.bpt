test "frame_snapshot_basic":
    source "test_image_state.b+"
    build dll
    exports Init, GetHistory00, GetHistory01, WriteHistory

    frame 0:
        call Init
        expect state.frame_index == 1
        expect state.accum_color == 0.5
        expect image["history"][0,0] == 42.0
        expect image["history"][0,1] == 0

    frame 1:
        call WriteHistory
        expect state.result == 43
        expect image["history"][0,0] == 43.0

    frame 2:
        call WriteHistory
        expect state.result == 44
        expect image["history"][0,0] == 44.0
