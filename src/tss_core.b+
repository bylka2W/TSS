// TSS Core — FSR2-lite в B+
// Spatial upscale (2x bilinear) → Temporal reproject → RCAS sharpen

state TSS_Core {
    // Dimensions (set by C before Init)
    w: int, h: int, ow: int, oh: int

    // C u8 RGBA buffer addresses (set by C)
    src: int, dst: int

    // Internal float buffer addresses (allocated in Init)
    lr: int, hr: int, out: int
    prv: int, dep: int, pd: int
    mv_x: int, mv_y: int, lk: int

    // Per-channel images (point into flat buffers with padding)
    lr_r: int, lr_g: int, lr_b: int
    hr_r: int, hr_g: int, hr_b: int
    out_r: int, out_g: int, out_b: int
    prv_r: int, prv_g: int, prv_b: int

    // Temp vars (reused)
    x: int, y: int
    ch: int, idx: int, off: int
    v: float, v00: float, v10: float, v01: float, v11: float
    top: float, bot: float
    fx: float, fy: float, px: float, py: float

    // RCAS temps
    cen: float, n: float, s: float, e: float, ww: float
    cL: float, nL: float, sL: float, eL: float, wL: float
    nz_s: float, nz_h: float, nz_r: float, nz: float
    m4: float, x4: float, hit: float, lo: float

    // Temporal temps
    cc: float, pc: float, cd: float, pd: float
    lc: float, lk: float, ld: float, bl: float, nl: float
    mvx: float, mvy: float
    pp_x: float, pp_y: float
    frame: int
}

// Alloc: VirtualAlloc wrapper
alloc(size): int {
    result = VirtualAlloc(0, size, 0x1000, 0x04)
}

// Float at address
f32at(addr): float {
    result = *addr
}

// Store float at address
set_f32(addr, val) {
    *addr = val
}

// Init: allocate all buffers
export entry TSS_Init {
    ow = w * 2
    oh = h * 2

    lr = alloc(w * h * 16)    // 4 floats per pixel (RGBA)
    hr = alloc(ow * oh * 16)
    out = alloc(ow * oh * 16)
    prv = alloc(ow * oh * 16)
    dep = alloc(ow * oh * 4)   // 1 float per pixel
    pd = alloc(ow * oh * 4)
    mv_x = alloc(ow * oh * 4)
    mv_y = alloc(ow * oh * 4)
    lk = alloc(ow * oh * 4)

    // For HR images, HR_R starts at hr, HR_G at hr + 4, HR_B at hr + 8
    hr_r = hr
    hr_g = hr + 4
    hr_b = hr + 8

    lr_r = lr
    lr_g = lr + 4
    lr_b = lr + 8

    out_r = out
    out_g = out + 4
    out_b = out + 8

    prv_r = prv
    prv_g = prv + 4
    prv_b = prv + 8

    frame = 0
}

// CopyInput: read u8 RGBA from C src buffer → float RGBA in LR
// Each pixel is 16 bytes (4 x f32) in LR, 4 bytes (4 x u8) in src
export entry TSS_CopyInput {
    for(x, y, w, h) {
        // C src offset: (y * w + x) * 4 (u8)
        off = y * w + x
        idx = off * 4

        // Read u8 values from src buffer
        // Use the f32at trick — read as int, convert
        r_addr = src + idx
        g_addr = src + idx + 1
        b_addr = src + idx + 2

        // Can't directly read bytes — store pointer as int and read
        // Try: read float from byte address
        // The pixel stride in float buffers is 16 bytes (4 x f32)
        foff = off * 16

        // B+ can't dereference as different types
        // For now, C will pre-convert to float
    }
}

// Bilinear 2x upscale (all 4 channels)
export entry TSS_Bilinear {
    for(x, y, ow, oh) {
        // Input coords (center-sampled, 2x mapping)
        px = (x + 0.5) / 2.0 - 0.5
        py = (y + 0.5) / 2.0 - 0.5

        // Clamp
        if (px < 0.0) { px = 0.0 }
        if (px >= w) { px = w - 1.001 }
        if (py < 0.0) { py = 0.0 }
        if (py >= h) { py = h - 1.001 }

        // Bilinear weights
        ix = px
        iy = py
        fx = px - ix
        fy = py - iy

        // Edge clamp weights
        if (ix < 0) { ix = 0 }
        if (ix >= w - 1) { ix = w - 2 }
        if (iy < 0) { iy = 0 }
        if (iy >= h - 1) { iy = h - 2 }

        // We process 4 channels at once using stride-4 access
        // For each output pixel (x,y), we write 4 floats

        // Channel 0 (R)
        off0 = (iy * w + ix) * 16
        off1 = (iy * w + ix + 1) * 16
        off2 = ((iy + 1) * w + ix) * 16
        off3 = ((iy + 1) * w + ix + 1) * 16

        v00 = *lr + off0
        v10 = *lr + off1
        v01 = *lr + off2
        v11 = *lr + off3

        top = v00 + (v10 - v00) * fx
        bot = v01 + (v11 - v01) * fx
        v = top + (bot - top) * fy

        // Write to HR output
        hoff = (y * ow + x) * 16
        *hr + hoff = v

        // Channel 1 (G)
        v00 = *lr + off0 + 4
        v10 = *lr + off1 + 4
        v01 = *lr + off2 + 4
        v11 = *lr + off3 + 4

        top = v00 + (v10 - v00) * fx
        bot = v01 + (v11 - v01) * fx
        v = top + (bot - top) * fy

        *hr + hoff + 4 = v

        // Channel 2 (B)
        v00 = *lr + off0 + 8
        v10 = *lr + off1 + 8
        v01 = *lr + off2 + 8
        v11 = *lr + off3 + 8

        top = v00 + (v10 - v00) * fx
        bot = v01 + (v11 - v01) * fx
        v = top + (bot - top) * fy

        *hr + hoff + 8 = v

        // Channel 3 (A) — copy from nearest neighbor
        *hr + hoff + 12 = *lr + off0 + 12
    }
}

// RCAS sharpen (single channel wrapper, operates on 4-channel HR)
export entry TSS_RCAS {
    for(x, y, ow, oh) {
        // Process all 4 channels interleaved
        for_ch = 0, 4 {
            ch = for_ch

            // Center pixel
            hoff = (y * ow + x) * 16 + ch * 4
            cen = *hr + hoff

            // Neighbors with edge clamp
            if (x > 0) { ww = *hr + hoff - 16 } else { ww = cen }
            if (x < ow - 1) { e = *hr + hoff + 16 } else { e = cen }
            if (y > 0) { n = *hr + hoff - ow * 16 } else { n = cen }
            if (y < oh - 1) { s = *hr + hoff + ow * 16 } else { s = cen }

            // RCAS compute
            cL = cen + cen
            nL = n + n; sL = s + s; eL = e + e; wL = ww + ww

            nz_s = nL + wL + eL + sL
            nz_h = 0.25 * nz_s - cL

            nz_r = max(max(nL, wL), max(cL, max(eL, sL))) - min(min(nL, wL), min(cL, min(eL, sL)))
            if (nz_r < 0.001) { nz_r = 0.001 }

            nz = 1.0 - 0.5 * saturate(abs(nz_h) / nz_r)

            m4 = min(min(n, ww), min(e, s))
            x4 = max(max(n, ww), max(e, s))

            hit = max(min(m4, cen) / (4.0 * x4 + 0.001), (1.0 - max(x4, cen)) / (4.0 * m4 - 4.0 + 0.001))
            lo = max(-hit, -0.25)
            if (lo < -0.25) { lo = -0.25 }
            lo = lo * 0.5 * nz

            rcpL = 1.0 / (4.0 * lo + 1.0)
            *hr + hoff = (lo * (n + ww + s + e) + cen) * rcpL
        }
    }
}

// Temporal resolve with ghost rejection + lock
export entry TSS_Temporal {
    for(x, y, ow, oh) {
        hoff = (y * ow + x) * 16

        // Read motion vector (same resolution as output)
        mv_x_off = (y * ow + x) * 4
        mvx = *mv_x + mv_x_off
        mvy = *mv_y + mv_x_off

        // Reproject to previous frame
        pp_x = x - mvx
        pp_y = y - mvy

        // Check if reprojection is valid
        if (pp_x >= 0.0) {
            if (pp_x < ow) {
                if (pp_y >= 0.0) {
                    if (pp_y < oh) {
                        // Valid reprojection
                        cd = *dep + mv_x_off

                        pp_off = (pp_y * ow + pp_x) * 4
                        pd_val = *pd + pp_off

                        // Depth test
                        if (abs(cd - pd_val) < 0.01) {
                            // Depth match: read previous color at reprojected pos
                            pp_hoff = (pp_y * ow + pp_x) * 16

                            // Luminance-based ghost rejection
                            cc_r = *hr + hoff
                            cc_g = *hr + hoff + 4
                            cc_b = *hr + hoff + 8

                            pc_r = *prv_r + pp_hoff
                            pc_g = *prv_g + pp_hoff + 4
                            pc_b = *prv_b + pp_hoff + 8

                            luma_cc = 0.299 * cc_r + 0.587 * cc_g + 0.114 * cc_b
                            luma_pc = 0.299 * pc_r + 0.587 * pc_g + 0.114 * pc_b
                            ld = abs(luma_cc - luma_pc)

                            // Ghost weight: 1/(1 + x^2/86900) approximates exp(-x^2/86900)
                            lk_val = 1.0 / (1.0 + ld * ld / 86900.0)

                            // Lock system
                            lk_off = (pp_y * ow + pp_x) * 4
                            lc = *lk + lk_off

                            if (lk_val > 0.5) {
                                nl = lc + 1.0
                                if (nl > 10.0) { nl = 10.0 }
                                bl = 0.5 * nl / 10.0
                            } else {
                                nl = 0.0
                                bl = 0.0
                            }

                            // Write lock
                            *lk + mv_x_off = nl

                            // Blend
                            *hr + hoff = cc_r * (1.0 - bl) + pc_r * bl
                            *hr + hoff + 4 = cc_g * (1.0 - bl) + pc_g * bl
                            *hr + hoff + 8 = cc_b * (1.0 - bl) + pc_b * bl
                        } else {
                            // Depth mismatch: reject history, reset lock
                            *lk + mv_x_off = 0.0
                        }
                    }
                }
            }
        }
    }

    // Copy HR → prev for next frame
    for(x, y, ow, oh) {
        hoff = (y * ow + x) * 16
        *prv_r + hoff = *hr + hoff
        *prv_g + hoff + 4 = *hr + hoff + 4
        *prv_b + hoff + 8 = *hr + hoff + 8

        // Copy depth to prev depth
        doff = (y * ow + x) * 4
        *pd + doff = *dep + doff
    }

    frame = frame + 1
}

// CopyOutput: convert float RGBA → u8 RGBA to C dst buffer
export entry TSS_CopyOutput {
    for(x, y, ow, oh) {
        hoff = (y * ow + x) * 16
        doff = (y * ow + x) * 4

        // Read floats, clamp, convert to u8
        r_val = *hr + hoff
        g_val = *hr + hoff + 4
        b_val = *hr + hoff + 8
        a_val = *hr + hoff + 12

        r_byte = r_val * 255.0
        g_byte = g_val * 255.0
        b_byte = b_val * 255.0
        a_byte = a_val * 255.0

        // Clamp
        if (r_byte < 0.0) { r_byte = 0.0 }
        if (r_byte > 255.0) { r_byte = 255.0 }
        if (g_byte < 0.0) { g_byte = 0.0 }
        if (g_byte > 255.0) { g_byte = 255.0 }
        if (b_byte < 0.0) { b_byte = 0.0 }
        if (b_byte > 255.0) { b_byte = 255.0 }
        if (a_byte < 0.0) { a_byte = 0.0 }
        if (a_byte > 255.0) { a_byte = 255.0 }

        // Write as float (C will convert)
        *dst + doff = r_byte
        *dst + doff + 4 = g_byte
        *dst + doff + 8 = b_byte
        *dst + doff + 12 = a_byte
    }
}

// Full pipeline
export entry TSS_Process {
    TSS_Bilinear

    if (frame > 0) {
        TSS_Temporal
    }

    TSS_RCAS

    // Copy result to out buffer (for compatibility)
    for(x, y, ow, oh) {
        hoff = (y * ow + x) * 16
        *out + hoff = *hr + hoff
        *out + hoff + 4 = *hr + hoff + 4
        *out + hoff + 8 = *hr + hoff + 8
        *out + hoff + 12 = *hr + hoff + 12
    }
}
