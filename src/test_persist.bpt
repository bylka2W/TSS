test "persist_basic":
    source "test_persist.b+"
    build dll
    reset per_case
    exports set, get

    case "get before set (zero init)":
        call get
        expect return 0

    case "set then get":
        call set
        call get
        expect return 42

    case "set then get again (same case)":
        call set
        call get
        call get
        expect return 42

    case "get after reload (back to zero)":
        call get
        expect return 0
