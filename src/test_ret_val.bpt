test "ret_val_basic":
    source "test_ret_val.b+"
    build dll
    reset per_case
    exports init, get_val, get_fval

    case "init":
        call init
        expect return float 3.14

    case "get_val after init":
        call init
        call get_val
        expect return 42

    case "get_fval after init":
        call init
        call get_fval
        expect return float 3.14
