test "image_state_basic":
    source "test_image_state.b+"
    build dll
    reset per_case
    exports Init, GetHistory00, GetHistory01, WriteHistory, GetAccumColor

    case "Init returns accum_color bitcast":
        call Init
        expect return 1056964608

    case "GetHistory00":
        call Init
        call GetHistory00
        expect return 42

    case "GetHistory01":
        call Init
        call GetHistory01
        expect return 0

    case "WriteHistory once":
        call Init
        call WriteHistory
        expect return 43

    case "WriteHistory twice":
        call Init
        call WriteHistory
        call WriteHistory
        expect return 44

    case "GetAccumColor (float return)":
        call Init
        call GetAccumColor
        expect return float 0.5
